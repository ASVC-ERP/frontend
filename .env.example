# ============================================================================
#  IMS frontend — environment
#  Copy to .env for local dev.
# ============================================================================

# Backend API base URL.
#   local dev   -> http://localhost:3000/api  (ims-backend running on :3000)
#   production  -> /api  (when the built frontend is served from the backend's
#                  ./public folder, same origin — see ims-backend/.env.example)
VITE_API_URL=http://localhost:3000/api
