.return-purchase-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1050;
  background: rgba(15, 23, 42, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.return-purchase-modal {
  width: min(1180px, 100%);
  max-height: 92vh;
}

.return-purchase-content {
  background: #ffffff;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 24px 70px rgba(15, 23, 42, 0.35);
}

.return-purchase-header {
  background: linear-gradient(135deg, #991b1b 0%, #dc2626 100%);
  color: white;
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.return-purchase-header h5 {
  margin: 0;
  font-size: 23px;
  font-weight: 700;
}

.return-purchase-header span {
  font-size: 18px;
  opacity: 0.85;
}

.return-close-btn {
  border: none;
  background: rgba(255, 255, 255, 0.18);
  color: white;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  font-size: 24px;
  line-height: 1;
  cursor: pointer;
}

.return-close-btn:hover {
  background: rgba(255, 255, 255, 0.28);
}

.return-purchase-body {
  padding: 24px;
  max-height: calc(92vh - 145px);
  overflow-y: auto;
  background: #f8fafc;
}

.return-purchase-body .form-label {
  font-size: 12px;
  font-weight: 700;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.return-purchase-body .form-control {
  border-radius: 10px;
  border: 1px solid #dbe3ef;
}

.return-purchase-body .form-control:focus {
  border-color: #dc2626;
  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
}

.return-items-table {
  background: white;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid #e2e8f0;
}

.return-items-table table {
  margin-bottom: 0;
}

.return-items-table thead th {
  background: #f1f5f9;
  color: #334155;
  font-size: 16px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  border-bottom: 1px solid #e2e8f0;
}

.return-items-table tbody td {
  vertical-align: middle;
}

.return-code {
  font-weight: 700;
  color: #1e5a84;
}

.return-product-name {
  font-weight: 700;
  color: #1e293b;
}

.return-product-meta {
  font-size: 18px;
  color: #64748b;
}

.return-badge {
  display: inline-flex;
  min-width: 42px;
  justify-content: center;
  padding: 5px 10px;
  border-radius: 999px;
  background: #ecfdf5;
  color: #15803d;
  font-weight: 700;
}

.return-badge.empty {
  background: #f1f5f9;
  color: #64748b;
}

.return-qty-input {
  max-width: 110px;
}

.return-qty-input:disabled {
  background: #f1f5f9;
  cursor: not-allowed;
}

.return-purchase-footer {
  background: white;
  border-top: 1px solid #e2e8f0;
  padding: 16px 24px;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

.return-cancel-btn {
  border: none;
  background: #e5e7eb;
  color: #374151;
  padding: 10px 18px;
  border-radius: 10px;
  font-size: 18px;
  font-weight: 600;
}

.return-submit-btn {
  border: none;
  background: linear-gradient(135deg, #991b1b, #dc2626);
  color: white;
  padding: 10px 18px;
  border-radius: 10px;
  font-size: 18px;
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
  transition: all 0.2s ease;
}

.return-submit-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 18px rgba(220, 38, 38, 0.35);
}

.return-submit-btn:active {
  transform: translateY(0);
}

.reason-counter {
  margin-top: 6px;
  text-align: right;
  font-size: 13px;
  color: #64748b;
  font-weight: 500;
}

.reason-counter.danger {
  color: #dc2626;
  font-weight: 700;
}